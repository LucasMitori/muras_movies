DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches ops/docker-compose.dev.yml, which maps the container to host port
# 5433 (5432 is often already taken by a native PostgreSQL install).
DATABASE_URL=postgres://muratori:muratori@localhost:5433/muratori

TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
